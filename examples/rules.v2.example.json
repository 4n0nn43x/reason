[
  {"id": "window-closes-before-event",
   "if": [{"path": "state.facts.window_end", "op": "before", "path2": "state.facts.event_at"}],
   "decide": {"name": "ask_human"},
   "reason": "Fenêtre de résolution close ({state.facts.window_end}) avant l'événement ({state.facts.event_at})"},
  {"id": "barrier-clause",
   "if": [{"path": "ruling_text", "op": "regex", "norm": true,
           "value": ["any .{0,40}(1|one)[- ]minute candle", "at any (point|time)", "(high|low) price (of|equal to)"]}],
   "decide": {"name": "ask_human"}, "reason": "Clause barrière détectée : « {match} »"},
  {"id": "static-source-near-resolution",
   "if": {"all": [{"path": "state.facts.resolves_at", "op": "hours_until_lte", "value": 48},
                  {"not": {"path": "state.facts.source_kind", "op": "eq", "value": "live"}}]},
   "forbid": ["open_thesis"], "reason": "source statique à moins de 48 h de la résolution"},
  {"id": "no-fallback-clause",
   "if": {"not": {"path": "ruling_text", "op": "regex", "norm": true, "value": "otherwise.{0,30}resolve"}},
   "forbid": ["open_thesis"], "reason": "aucune clause de repli dans le critère de résolution"},
  {"id": "vip-or-over-limit",
   "if": {"any": [{"path": "state.facts.vip", "op": "eq", "value": true},
                  {"path": "state.facts.amount", "op": "gte", "path2": "state.facts.limit"}]},
   "forbid": ["auto_close"], "reason": "client VIP ou montant {state.facts.amount} au-dessus de la limite {state.facts.limit}"},
  {"id": "maintenance-window",
   "if": {"all": [{"path": "now", "op": "after", "path2": "state.ops.freeze_start"},
                  {"path": "now", "op": "before", "path2": "state.ops.freeze_end"}]},
   "forbid": ["deploy", "rollback"], "reason": "gel des changements jusqu'à {state.ops.freeze_end}"}
]
