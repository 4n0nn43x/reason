{
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "http", "url": "http://127.0.0.1:8787/hooks/claude", "timeout": 10,
                                     "headers": {"Authorization": "Bearer $REASON_TOKEN"}, "allowedEnvVars": ["REASON_TOKEN"]}]}],
